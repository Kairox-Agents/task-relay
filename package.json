{
  "name": "task-relay",
  "version": "0.1.0",
  "description": "Local worker daemon for remote agent task execution over Tailscale",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "task-relay": "./dist/cli.js",
    "task-relay-mcp": "./dist/mcp/server.js"
  },
  "scripts": {
    "dev": "tsx watch src/cli.ts start",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "agents",
    "claude-code",
    "mcp",
    "task-queue",
    "worker"
  ],
  "author": "Philip Bankier",
  "license": "BUSINESS-SOURCE-LICENSE-1.1",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.104",
    "@aws-sdk/client-s3": "^3.1030.0",
    "@hono/node-server": "^1.8.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^11.0.0",
    "commander": "^12.0.0",
    "hono": "^4.0.0",
    "pino": "^8.19.0",
    "uuid": "^9.0.1",
    "yaml": "^2.4.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.10",
    "@types/node": "^20.19.39",
    "@types/uuid": "^9.0.8",
    "eslint": "^8.57.0",
    "prettier": "^3.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "zod": "^3.25.0"
  }
}
